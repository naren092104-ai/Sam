  "workspaces": ["frontend", "backend"],
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.4",
    "@rollup/rollup-linux-x64-musl": "4.60.4",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
